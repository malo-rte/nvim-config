# PATH additions live in the image (ENV PATH), so a one-shot
# `docker run ... <cmd>` sees the same tools an interactive shell does.
export SHELL=/bin/bash

# direnv requires per-directory `direnv allow` from the host; the container
# inherits the host's bind-mounted .envrc state so the prompt is consistent.
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook bash)"
fi

eval "$(starship init bash)"
